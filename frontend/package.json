{
  "name": "@krim-agent/browser-ui",
  "version": "0.4.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test:contracts": "node --experimental-strip-types contracts/agent-core.test.ts && node --experimental-strip-types contracts/evaluation.test.ts && node --experimental-strip-types contracts/agent-core.test.ts && node --experimental-strip-types contracts/agent-workspace.test.ts",
    "test:e2e": "playwright test",
    "test:components": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "shadcn": "4.22.0",
    "tw-animate-css": "1.4.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "22.20.5",
    "vitest": "5.0.5",
    "jsdom": "30.1.3"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "lucide-react": "1.58.0"
  }
}
