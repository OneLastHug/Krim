{
  "name": "@krim-agent/browser-ui",
  "version": "0.4.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test:contracts": "node --experimental-strip-types contracts/agent-core.test.ts && node --experimental-strip-types contracts/evaluation.test.ts && node --experimental-strip-types contracts/agent-core.test.ts && node --experimental-strip-types contracts/agent-workspace.test.ts && node --experimental-strip-types contracts/session-presentation.test.ts",
    "test:e2e": "playwright test",
    "test:components": "vitest run --config vitest.config.ts",
    "dev:prototype": "vite --config vite.prototype.config.ts",
    "build:prototype": "tsc --noEmit && vite build --config vite.prototype.config.ts",
    "test:prototype": "playwright test --config playwright.prototype.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "shadcn": "4.22.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0"
  }
}
