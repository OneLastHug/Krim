{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    "contracts/agent-core.test.ts",
    "contracts/evaluation.test.ts",
    "contracts/agent-core.test.ts",
    "contracts/agent-workspace.test.ts",
    "contracts/run-ui.test.tsx",
    "contracts/eval-ui.test.tsx",
    "contracts/session-ui.test.tsx",
    "contracts/agent-workspace-ui.test.tsx",
    "contracts/workbench-ui.test.tsx",
    "contracts/legacy-gate-ui.test.tsx",
    "contracts/trace-ui.test.tsx",
    "contracts/product-evaluation-ui.test.tsx",
    "contracts/workspace-form-ui.test.tsx",
    "contracts/evaluation-automation-ui.test.tsx",
    "e2e/agent-core.spec.ts",
    "e2e/agent-core-ui.spec.ts",
    "e2e/evaluation.spec.ts",
    "e2e/http-provider.spec.ts",
    "e2e/chat.spec.ts",
    "e2e/agent-workspace.spec.ts",
    "e2e/step-screenshot.spec.ts",
    "e2e/workbench-phases.spec.ts",
    "e2e/product-evaluation.spec.ts",
    "e2e/prepared-workspace.spec.ts",
    "e2e/evaluation-automation.spec.ts",
    "e2e/installed-package-readonly.spec.ts",
    "e2e/workbench-redesign.spec.ts",
    "e2e/legacy-access.spec.ts",
    "e2e/compact-composer.spec.ts",
    "vite.prototype.config.ts",
    "playwright.prototype.config.ts",
    "e2e/prototype.spec.ts",
    "e2e/prototype-native-zoom.spec.ts"
  ]
}
