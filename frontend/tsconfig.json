{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": [
    "contracts/subagent-*.test.ts*",
    "contracts/memory*.test.ts*",
    "contracts/planning-*.test.ts*",
    "contracts/interaction-ui.test.tsx",
    "contracts/session-features*.test.ts*",
    "contracts/browser/session-features.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "vite.session-features.config.ts",
    "vite.integration.config.ts",
    "vite.visual.config.ts",
    "visual/**/*.tsx",
    "contracts/session-sidebar*.test.ts*",
    "contracts/development-*.test.ts*",
    "vitest.config.ts",
    "contracts/accounts.test.ts",
    "contracts/account-settings-ui.test.tsx",
    "contracts/account-identity-ui.test.tsx",
    "contracts/agent-core.test.ts",
    "contracts/evaluation.test.ts",
    "contracts/agent-core.test.ts",
    "contracts/agent-workspace.test.ts",
    "contracts/run-ui.test.tsx",
    "contracts/eval-ui.test.tsx",
    "contracts/session-ui.test.tsx",
    "contracts/session-selection-ui.test.tsx",
    "contracts/session-adapter-ui.test.tsx",
    "contracts/session-lifecycle-ui.test.tsx",
    "contracts/session-presentation.test.ts",
    "contracts/message-ui.test.tsx",
    "contracts/agent-workspace-ui.test.tsx",
    "contracts/workbench-ui.test.tsx",
    "contracts/workbench-refinements.test.tsx",
    "contracts/legacy-gate-ui.test.tsx",
    "contracts/trace-ui.test.tsx",
    "contracts/product-evaluation-ui.test.tsx",
    "contracts/workspace-form-ui.test.tsx",
    "contracts/evaluation-automation-ui.test.tsx",
    "contracts/observability-quality-ui.test.tsx",
    "contracts/observability-export.test.ts",
    "contracts/observability-contract.test.ts",
    "contracts/observability-ui.test.tsx",
    "e2e/agent-core.spec.ts",
    "e2e/agent-core-ui.spec.ts",
    "e2e/evaluation.spec.ts",
    "e2e/http-provider.spec.ts",
    "e2e/chat.spec.ts",
    "e2e/agent-workspace.spec.ts",
    "e2e/step-screenshot.spec.ts",
    "e2e/workbench-phases.spec.ts",
    "e2e/product-evaluation.spec.ts",
    "e2e/prepared-workspace.spec.ts",
    "e2e/evaluation-automation.spec.ts",
    "e2e/installed-package-readonly.spec.ts",
    "e2e/workbench-redesign.spec.ts",
    "e2e/legacy-access.spec.ts",
    "e2e/compact-composer.spec.ts",
    "e2e/session-row-hover.spec.ts",
    "vite.prototype.config.ts",
    "playwright.prototype.config.ts",
    "e2e/prototype.spec.ts",
    "e2e/prototype-native-zoom.spec.ts",
