# Krim Agent：需显式加载，不自动读取 .env。
KRIM_AGENT_PROVIDER=script
KRIM_AGENT_DATABASE=.data/krim-agent.db
# API Key 只保护本地实例；不在 URL 或日志里传递。
KRIM_AGENT_API_KEY=

# auto 自动识别已初始化的账号数据库；managed 要求先用 account bootstrap/import 初始化。
# 托管账号模式不能同时配置旧全局 API_KEY 或 ACCESS_POLICY_FILE。
KRIM_AGENT_IDENTITY_MODE=auto
# 仅公开显示别名，不改变模型地址、路由或凭据。
# KRIM_AGENT_GATEWAY_DISPLAY_NAME=API 网关

# HTTP目标由宿主显式启用；默认脚本不读取这些变量。不自动加载此文件。
# 明文本机只允许127.0.0.1/[::1]；非本机须HTTPS，本轮仅测本机fixture。
# KRIM_AGENT_HTTP_BASE_URL=http://127.0.0.1:19001/v1
# KRIM_AGENT_HTTP_MODEL=fixture
# 出站模型密钥，与上面的实例API_KEY分离；不得放URL或浏览器。
# KRIM_AGENT_HTTP_API_KEY=
# KRIM_AGENT_HTTP_MAX_OUTPUT_TOKENS=512

# 正式多步Agent：同时设置provider和mode；演示仍沿原有受限配置。
# KRIM_AGENT_PROVIDER=http
# KRIM_AGENT_HTTP_MODE=agent
# 以下为正式Agent默认预算；显式环境变量会覆盖默认值。
# 升级旧演示服务时请检查是否仍保留2/1/1，不会自动迁移旧环境文件。
# KRIM_AGENT_MAX_STEPS=8
# KRIM_AGENT_MAX_TOOLS_PER_STEP=4
# KRIM_AGENT_MAX_TOOL_CALLS=32
# 人工审批等待独立于工具和运行执行计时，默认/上限300秒。
# KRIM_AGENT_APPROVAL_TIMEOUT=300

# 沙箱管理地基：指定权限为0600的可信JSON配置后启用；默认关闭。
# 可信JSON可另设broker_socket接入XFS存储Broker；未连接时不宣称硬配额已生效。
# 仅显式配置command_image并在Broker启用同一固定镜像后，开放经人工审批的sandbox/1命令工具。
# 普通管理API没有任意exec入口；正式UI保持原样。
# KRIM_AGENT_SANDBOX_CONFIG_FILE=.data/sandbox.json
