KRIM_AGENT_DATABASE_URL=sqlite+aiosqlite:///./.data/krim-agent.db
KRIM_AGENT_API_KEY=
KRIM_AGENT_MAX_STEPS=8
KRIM_AGENT_TOOL_TIMEOUT_SECONDS=10
KRIM_AGENT_RUN_TIMEOUT_SECONDS=60
KRIM_AGENT_MAX_ACTIVE_RUNS=16

# 默认离线fake；设置为openai-compatible才使用已配置的模型端点。
KRIM_AGENT_PROVIDER=fake
# 本地兼容端点示例，不自动访问或下载模型。
# KRIM_AGENT_PROVIDER_BASE_URL=http://127.0.0.1:8000/v1
# KRIM_AGENT_PROVIDER_MODEL=your-local-model-name
# KRIM_AGENT_PROVIDER_API_KEY=
# KRIM_AGENT_PROVIDER_INCLUDE_USAGE=true
# KRIM_AGENT_PROVIDER_MAX_OUTPUT_TOKENS=512
# KRIM_AGENT_CONTEXT_TOKENIZER=cl100k_base
# KRIM_AGENT_CONTEXT_RESERVED_OUTPUT_TOKENS=512
