# Krim Agent：需显式加载，不自动读取 .env。
KRIM_AGENT_PROVIDER=script
KRIM_AGENT_DATABASE=.data/krim-agent.db
# API Key 只保护本地实例；不在 URL 或日志里传递。
KRIM_AGENT_API_KEY=

# HTTP目标由宿主显式启用；默认脚本不读取这些变量。不自动加载此文件。
# 明文本机只允许127.0.0.1/[::1]；非本机须HTTPS，本轮仅测本机fixture。
# KRIM_AGENT_HTTP_BASE_URL=http://127.0.0.1:19001/v1
# KRIM_AGENT_HTTP_MODEL=fixture
# 出站模型密钥，与上面的实例API_KEY分离；不得放URL或浏览器。
# KRIM_AGENT_HTTP_API_KEY=
# KRIM_AGENT_HTTP_MAX_OUTPUT_TOKENS=512
